{
  "name": "dsh-vibecoding",
  "description": "5-Step TDD & Multi-Agent Vibecoding Orchestrator with Git Worktrees and UI button for DeepSeek Harness (DSH)",
  "version": "1.4.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "files": [
    "lib/index.js",
    "lib/worktree.js",
    "lib/client.js",
    "skills/tdd-workflow/SKILL.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "vibecoding",
    "tdd",
    "git-worktree",
    "multi-agent",
    "dsh-plugin",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denssdenss99-a11y/dsh-vibecoding.git"
  },
  "license": "MIT",
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.0 || ^1.0.0"
  }
}
